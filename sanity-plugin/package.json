{
  "name": "sanity-plugin-agentprose",
  "version": "0.1.3",
  "description": "Sanity Studio tool for agentprose: see what AI agents read from your dataset through WebMCP, and get the one-line install for your website.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "agentprose",
    "webmcp",
    "mcp",
    "ai-agents",
    "llm",
    "groq"
  ],
  "homepage": "https://salnikov.no/agentprose/sanity/",
  "bugs": {
    "url": "https://github.com/webmaxru/agentprose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webmaxru/agentprose.git",
    "directory": "sanity-plugin"
  },
  "license": "MIT",
  "author": "Maxim Salnikov and agentprose contributors",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "studio:build": "node test/studio/link.mjs && cd test/studio && sanity build --yes",
    "test:studio": "npm run studio:build && node test/studio-e2e.mjs"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/ui": "^4.4.10",
    "agentprose": "^0.1.3"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^13.0.16",
    "@sanity/plugin-kit": "^10.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "groq-js": "2.0.1",
    "happy-dom": "^15.11.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.20.0",
    "styled-components": "^6.6.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9",
    "playwright-core": "^1.56.0"
  },
  "peerDependencies": {
    "react": "^19.2",
    "sanity": "^5 || ^6.0.0-0",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}
