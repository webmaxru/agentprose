---
import Default from '@astrojs/starlight/components/Footer.astro';
import PostHog from './posthog.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<PostHog />
<Default><slot /></Default>
<div class="ap-footer">
  <p>
    <a href="https://github.com/webmaxru/agentprose" data-posthog-outbound="github">GitHub</a>
    <span aria-hidden="true">·</span>
    <a href="https://www.npmjs.com/package/agentprose" data-posthog-outbound="npm">npm</a>
    <span aria-hidden="true">·</span>
    <a href="https://agentprose.cloud" data-posthog-outbound="cloud">agentprose Cloud</a>
    <span aria-hidden="true">·</span>
    <a href={`${base}project/changelog/`}>Changelog</a>
  </p>
  <p>MIT licensed. The core, every tool, the CLI, all adapters and the WordPress plugin stay free and open source.</p>
</div>
<script is:inline>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    const documentationPath = event.target.closest('[data-posthog-path]')?.getAttribute('data-posthog-path');
    if (documentationPath) {
      window.posthog?.capture('documentation_path_selected', { documentation_path: documentationPath });
      window.posthog?.logger?.info('documentation path selected', {
        event: 'documentation_path_selected',
        documentation_path: documentationPath,
      });
      return;
    }

    const outboundResource = event.target.closest('[data-posthog-outbound]')?.getAttribute('data-posthog-outbound');
    if (outboundResource) {
      window.posthog?.capture('outbound_resource_opened', { resource: outboundResource });
      window.posthog?.logger?.info('outbound resource opened', {
        event: 'outbound_resource_opened',
        resource: outboundResource,
      });
    }
  });
</script>
<style>
  .ap-footer { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--sl-color-hairline); font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
  .ap-footer p { margin: 0.25rem 0; }
  .ap-footer a { color: var(--sl-color-gray-2); text-decoration: none; }
  .ap-footer a:hover { color: var(--sl-color-accent-high); text-decoration: underline; }
  .ap-footer span { margin: 0 0.35rem; }
</style>
